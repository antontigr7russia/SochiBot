import os
import asyncio
import logging
from aiogram import Bot, Dispatcher, F, types
from aiogram.filters import CommandStart
from aiogram.fsm.context import FSMContext
from aiogram.fsm.state import State, StatesGroup
from aiogram.types import ReplyKeyboardMarkup, KeyboardButton
from openai import AsyncOpenAI

TELEGRAM_TOKEN = os.getenv("BOT_TOKEN")
AI_API_KEY = os.getenv("AI_API_KEY")

AI_BASE_URL = "https://aitunnel.ru"
MODEL_NAME = "gpt-4o-mini"

logging.basicConfig(level=logging.INFO)

bot = Bot(token=TELEGRAM_TOKEN)
dp = Dispatcher()

ai_client = AsyncOpenAI(
    api_key=AI_API_KEY,
    base_url=AI_BASE_URL
)

class BotStates(StatesGroup):
    waiting_for_good_traits = State()
    waiting_for_bad_traits = State()

main_keyboard = ReplyKeyboardMarkup(
    keyboard=[
        [KeyboardButton(text="🌟 Узнать, на кого равняться")],
        [KeyboardButton(text="⚠️ Разобрать плохой пример")]
    ],
    resize_keyboard=True
)

PROMPT_GOOD = """
Ты — мудрый психолог, наставник и аналитик человеческих судеб. 
Пользователь опишет черты характера, привычки или поведение человека, на которого он хочет равняться.
Твоя задача — дать честный, глубокий и структурированный разбор по пунктам:
1. Оценка ориентира: стоит ли брать такого человека за образец и в чём его главная сила.
2. Скрытые риски: какие минусы, перекосы или опасности могут скрываться за этими чертами (когда равняться на него вредно).
3. Реальные примеры: приведи 2–3 известных исторических личности, выдающихся деятелей или ярких примера людей с такими качествами.
4. Альтернатива: если выбранный образ слишком противоречив или опасен для психики/жизни, посоветуй, на кого лучше переключить фокус и почему.
Пиши живым, понятным русским языком, без воды, с абзацами и списками.
"""

PROMPT_BAD = """
Ты — мудрый психолог, эксперт по токсичному поведению и жизненным стратегиям.
Пользователь опишет черты характера, поступки или типаж человека (возможно, плохой или разрушительный пример).
Твоя задача — дать чёткий и отрезвляющий разбор по пунктам:
1. Почему нельзя брать пример: объясни, к каким последствиям в жизни, отношениях и карьере приводят эти черты.
2. Примеры из истории или жизни: приведи 2–3 ярких примера людей или известных типажей, которых погубили или завели в тупик подобные качества.
3. Здоровая альтернатива: покажи, какими сильными и созидательными качествами стоит заменить это поведение, и на кого лучше равняться вместо этого.
Пиши объективно, без морализаторства, понятным языком с чёткой структурой.
"""

@dp.message(CommandStart())
async def cmd_start(message: types.Message, state: FSMContext):
    await state.clear()
    await message.answer(
        "Привет! Я помогу тебе разобраться в людях, ролевых моделях и жизненных стратегиях.\n\n"
        "Выбери нужное действие на клавиатуре ниже 👇",
        reply_markup=main_keyboard
    )

@dp.message(F.text == "🌟 Узнать, на кого равняться")
async def ask_good_traits(message: types.Message, state: FSMContext):
    await state.set_state(BotStates.waiting_for_good_traits)
    await message.answer(
        "Опиши черты характера, привычки или ценности человека, на которого ты хочешь равняться.\n\n"
        "Например: *«Целеустремлённый, жёсткий в бизнесе, работает по 14 часов, не терпит слабости»* или *«Спокойный, умеет слушать, помогает другим, не гонится за деньгами»*.",
        parse_mode="Markdown"
    )

@dp.message(F.text == "⚠️ Разобрать плохой пример")
async def ask_bad_traits(message: types.Message, state: FSMContext):
    await state.set_state(BotStates.waiting_for_bad_traits)
    await message.answer(
        "Опиши черты характера, привычки или поведение человека, которое вызывает сомнения или кажется разрушительным.\n\n"
        "Я объясню, почему с него не стоит брать пример, к чему это приводит и какие есть здоровые альтернативы.",
        parse_mode="Markdown"
    )

async def get_ai_response(system_prompt: str, user_text: str) -> str:
    try:
        response = await ai_client.chat.completions.create(
            model=MODEL_NAME,
            messages=[
                {"role": "system", "content": system_prompt},
                {"role": "user", "content": user_text}
            ],
            temperature=0.7,
            max_tokens=1500
        )
        return response.choices.message.content
    except Exception as e:
        logging.error(f"Ошибка при обращении к ИИ: {e}")
        return f"Произошла техническая ошибка при анализе ({e}). Пожалуйста, попробуйте ещё раз через минуту."

@dp.message(BotStates.waiting_for_good_traits)
async def process_good_traits(message: types.Message, state: FSMContext):
    wait_msg = await message.answer("⏳ Анализирую качества и подбираю примеры...")
    answer = await get_ai_response(PROMPT_GOOD, message.text)
    await wait_msg.delete()
    await message.answer(answer, reply_markup=main_keyboard)
    await state.clear()

@dp.message(BotStates.waiting_for_bad_traits)
async def process_bad_traits(message: types.Message, state: FSMContext):
    wait_msg = await message.answer("⏳ Разбираю модель поведения и ищу альтернативы...")
    answer = await get_ai_response(PROMPT_BAD, message.text)
    await wait_msg.delete()
    await message.answer(answer, reply_markup=main_keyboard)
    await state.clear()

@dp.message()
async def fallback_handler(message: types.Message):
    await message.answer(
        "Пожалуйста, сначала выбери один из режимов с помощью кнопок внизу 👇",
        reply_markup=main_keyboard
    )

async def main():
    print("Бот успешно запущен и готов к работе!")
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
